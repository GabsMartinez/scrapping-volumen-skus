# Copia este archivo como .env y ajusta lo que necesites.
# .env NO se sube a git (ver .gitignore).

# --- Postgres local (docker-compose.yml) -----------------------------------
# Puerto de la máquina donde queda expuesto Postgres (localhost:<puerto>).
# Cámbialo si ya hay otro Postgres usando ese puerto.
DB_PUERTO_HOST=5437
DB_NAME=scraper_precios
DB_USER=scraper
DB_PASSWORD=scraper_local_pw

# --- Supabase (opcional, ver docs/MIGRACION_SUPABASE.md) -----------------------
# Project Settings -> Database -> Connection string -> URI, modo "Session",
# puerto 5432 (NO el pooler de transacciones en 6543).
SUPABASE_DIRECT_URL=
